grammar USDA;

// Parser Rules
usdFile : header? layer;

header: '#usda' version NEWLINE;

version: '1.0' | '1.1' | '1.2';

layer : LAYER? layerBody;

layerBody : statement*;

statement
    : comment
    | customLayerData
    | payload
    | prim
    | propertySpec+
    | reference
    | references
    | resource
    | resources
    | subLayer
    | variantSet
    ;

prim : 'def' primType? primName ('(' inherits ')')? primBody?;

primType : IDENTIFIER;

primName : STRING | IDENTIFIER;

inherits : IDENTIFIER (',' IDENTIFIER)*
         | statement*;

primBody : '{' primStatement* '}';

primStatement
    : prim
    | variantSet
    | reference
    | customData
    | comment
    | propertySpec+
    | references
    | payload
    | resource
    | resources
    ;

propertySpec : operation? type? ( IDENTIFIER | STRING) ( ( '=' | '=(' metadataList ')')  value )?;

value
    : NUMBER
    | STRING
    | IDENTIFIER
    | arrayValue
    | '{' (keyValuePair (',' keyValuePair)*)? '}'
    | timeSample
    | resource
    | resources
    | closeTag
    | '(' value (',' value)* ')'
    ;

operation : 'prepend';

resources : '[' resource (',' resource)* ']';

resource : '@' RESOURCE extension? '@' closeTag?;

extension : ( '.usda' | '.usd' | '.drc');

references : operation? 'references' '=' (resource | resources | closeTag);

payload : 'payload' '=' (resource | resources | closeTag);

closeTag : '</' IDENTIFIER '>';

arrayValue : '[' (value (',' value)*)? ']';

dictionaryValue : '{' (keyValuePair (',' keyValuePair)*)? '}';

keyValuePair : (STRING | IDENTIFIER) ':' value;

timeSample : '{' timeSampleItem+ '}';

timeSampleItem : NUMBER ':' value ','?;

variantSet : 'variantSet' IDENTIFIER '=' '{' variant+ '}';

variant : 'variant' STRING '=' '{' statement* '}';

reference : 'rel' IDENTIFIER '=' (IDENTIFIER | STRING);

subLayer : 'subLayers' '=' '[' STRING (',' STRING)* ']';

customLayerData : 'customLayerData' dictionaryValue;

customData : 'customData' dictionaryValue;

metadataList : metadata (',' metadata)*;

metadata : IDENTIFIER ('=' value)?;

comment : COMMENT;

type : (('Vec3f' | 'PointIndex' | 'dictionary' | 'string' | 'int' | 'token' | 'float' | 'asset' | 'double' | 'float3' | 'color3f' | 'uniform')+ ARRAY?); 


// Lexer Rules
ARRAY : '[]';
LAYER : 'layer';
IDENTIFIER : [a-zA-Z_][a-zA-Z0-9_:./]*;
RESOURCE : [a-zA-Z_.][a-zA-Z0-9_:./=]+;
STRING : '"' (~["\r\n] | '\\"')* '"';
NUMBER : [-+]?[0-9]*[.]?[0-9]+([eE][-+]?[0-9]+)?;
COMMENT : ('#' ~[\r\n]* | '//' ~[\r\n]*) -> skip;
WS : [ \t\r\n]+ -> skip;
NEWLINE: '\r'? '\n';
